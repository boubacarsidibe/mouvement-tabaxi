# Copier ce fichier en .env et adapter les valeurs. Ne jamais versionner .env.
# DJANGO_DEBUG=1 : développement local. Sans cette ligne, le serveur se comporte comme en
# production (https obligatoire) et exige une vraie clé secrète, générée par exemple avec :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=remplacer-par-une-longue-valeur-aleatoire
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Production uniquement (DJANGO_DEBUG absent ou 0).
# DJANGO_BEHIND_HTTPS_PROXY=1 si l'hébergeur termine le https devant Django.
DJANGO_BEHIND_HTTPS_PROXY=0
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_PRELOAD=0

# Nombre maximal de demandes d'adhésion par heure depuis une même adresse.
ADHESION_RATE=10/hour

# Courriels. Sans EMAIL_HOST, ils sont affichés dans la console (développement).
# Avec EMAIL_HOST, ils partent par SMTP. Identifiant et mot de passe : uniquement dans .env.
DEFAULT_FROM_EMAIL=Mouvement TABAXI <ne-pas-repondre@localhost>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10

# Adresse publique du frontend, utilisée dans les liens personnels envoyés par courriel.
FRONTEND_URL=http://localhost:4200

# Blocage temporaire de la connexion après plusieurs échecs.
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_LOCKOUT_MINUTES=15
# Nombre de proxys de confiance devant Django en production (0 en local).
LOGIN_TRUSTED_PROXIES=0

# Fermeture de la session du bureau après cette durée sans action (minutes).
BUREAU_INACTIVITY_MINUTES=30
